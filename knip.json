{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.js",
    "src/boot.js",
    "scripts/*.mjs",
    "scripts/service-worker.js",
    "test/unit/**/*.test.js",
    "test/e2e/**/*.spec.js"
  ],
  "project": [
    "src/**/*.js",
    "scripts/**/*.{js,mjs}",
    "test/**/*.js",
    "types/**/*.d.ts",
    "*.js"
  ],
  "paths": {
    "three": [
      "lib/three/three.module.js"
    ],
    "three/addons/*": [
      "lib/three/addons/*"
    ]
  },
  "ignoreUnresolved": [
    "/src/strings.js"
  ]
}
