{
  "name": "the-substitute",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-based 3D classroom-management game built on Three.js.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build-site.mjs",
    "preview": "node scripts/build-site.mjs --base /the-substitute-game/ && node scripts/serve.mjs 8080 --root _site --base /the-substitute-game/",
    "test": "npm run lint && npm run test:coverage && npm run test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/rules.js --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint . && node scripts/check-cycles.mjs && npm run typecheck && npm run deadcode",
    "deadcode": "knip",
    "typecheck": "tsc -p tsconfig.json",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "vendor-three": "node scripts/vendor-three.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@gltf-transform/core": "4.3.0",
    "@gltf-transform/extensions": "4.3.0",
    "@gltf-transform/functions": "4.3.0",
    "@playwright/test": "1.56.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "meshoptimizer": "0.25.0",
    "three": "0.186.0",
    "typescript": "5.9.3"
  }
}
